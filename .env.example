# Dùng database local riêng, không điền secret thật vào file example.
DB_URL=jdbc:postgresql://localhost:5432/snaplink
DB_USERNAME=snaplink
DB_PASSWORD=change-me
REDIS_URL=redis://localhost:6379
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
# Thay bằng chuỗi ngẫu nhiên riêng, tối thiểu 32 byte; không dùng giá trị mẫu để deploy.
JWT_SECRET=replace-this-with-your-own-random-secret-at-least-32-bytes
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Chỉ bật nếu ứng dụng không nhận request trực tiếp và proxy lọc/ghi đè forwarding headers.
TRUST_PROXY_HEADERS=false
# Tuỳ chọn: đường dẫn tuyệt đối tới GeoLite2-Country.mmdb, để trống nếu chưa có.
GEOIP_DATABASE_PATH=
